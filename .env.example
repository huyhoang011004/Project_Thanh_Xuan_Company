# ========================================================
# CẤU HÌNH MASTER DOCKER COMPOSE TOÀN HỆ THỐNG (LOCAL & VPS)
# ========================================================

# --- Cổng Port Máy Chủ Host ---
PORT_FRONTEND=3000
PORT_FE_INTERNAL=3001
PORT_BACKEND=5001
PORT_MONGODB=27018

# --- Cấu hình Domain / URL ---
# Khi chạy Local:
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:5001

# Khi deploy lên VPS (Dùng IP VPS trực tiếp thay vì api.thanhxuanlaundry.com):
# NEXT_PUBLIC_API_URL=http://103.200.22.238:5001
# NEXT_PUBLIC_SITE_URL=https://thanhxuanlaundry.com
# FRONTEND_URL=https://thanhxuanlaundry.com

# --- Database MongoDB (Multi-Database Architecture) ---
MONGO_INITDB_DATABASE=thanh_xuan
MONGODB_LAUNDRY_URI=mongodb://mongodb:27017/laundry_express
MONGODB_MOVING_URI=mongodb://mongodb:27017/moving_express
MONGODB_INTERNAL_URI=mongodb://mongodb:27017/internal_express
MONGODB_CORE_URI=mongodb://mongodb:27017/core_express

# --- Xác thực JWT ---
JWT_SECRET=thanh_xuan_laundry_super_secure_jwt_secret_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_COOKIE_MAX_AGE=900
JWT_REFRESH_COOKIE_MAX_AGE=604800
STAFF_JWT_SECRET=staff-super-secure-secret-2026
STAFF_JWT_EXPIRES_IN=12h

# --- CORS Danh Sách Domain & IP Được Phép ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://103.200.22.238:3000,http://103.200.22.238:3001,https://thanhxuanlaundry.com,https://chuyennhatietkiem.vn,https://noibo.thanhxuanlaundry.com

# --- Gửi Email Thông Báo SMTP (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
COMPANY_EMAIL=info@example.com

# --- Cấu hình AI Gemini / OpenAI ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Cấu hình Zalo OA ---
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_OA_ID=
ZALO_WEBHOOK_SECRET=

# --- Lưu Trữ Ảnh Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Tọa Độ Định Vị Xưởng Chấm Công ---
WORKSHOP_LATITUDE=20.99824
WORKSHOP_LONGITUDE=105.80153
WORKSHOP_RADIUS_METERS=150
WORKSHOP_MAX_ACCURACY=350
WORKSHOP_GPS_REQUIRED=true
